{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task State",
  "description": "Persistent execution state for a task within a feature project.",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string"
    },
    "taskName": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "inputs": {
      "type": "object"
    },
    "outputs": {
      "type": "object"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "taskId",
    "status"
  ],
  "additionalProperties": true
}
