{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Runtime State",
  "description": "Aggregate working state stored under a feature project's _work directory.",
  "type": "object",
  "properties": {
    "project": {
      "type": "object"
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "workingMemory": {
      "type": "object"
    },
    "executionLogPath": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "project"
  ],
  "additionalProperties": true
}
