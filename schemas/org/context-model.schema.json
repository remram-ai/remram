    "governanceLayer": {
      "type": "object"
    },
    "teamLayer": {
      "type": "object"
    },
    "roleLayer": {
      "type": "object"
    },
    "workflowLayer": {
      "type": "object"
    },
    "taskTemplateLayer": {
      "type": "object"
    },
    "projectContext": {
      "type": "object"
    },
    "stageContext": {
      "type": "object"
    },
    "workingMemory": {
      "type": "object"
    },
    "toolLayer": {
      "type": "object"
    }
