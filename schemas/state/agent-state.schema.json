{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent State",
  "description": "Persistent execution state for an agent working within a feature project.",
  "type": "object",
  "properties": {
    "agentId": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "currentTask": {
      "type": "string"
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "agentId",
    "status"
  ],
  "additionalProperties": true
}
